---
/**
 * El globo de las salas (VII · Trayectoria). La firma de la sección: el scroll
 * gira un globo de puntos desde Bogotá hacia cada sala donde ha tocado La
 * Joven, con encuadres suaves sobre las Américas, el cruce a Europa y el plano
 * completo. Los arcos se elevan sobre la esfera y se dibujan al ritmo del
 * scroll; al llegar, la ciudad se enciende y su sala aparece en grande.
 *
 * Optimizado para teléfono:
 *   - Canvas 2D y proyección ortográfica propia: cero librerías.
 *   - Los ~4000 puntos de tierra (15 KB, scripts/globo.mjs) se piden solo
 *     cuando el globo se acerca a la pantalla.
 *   - Solo se redibuja si cambia el scroll, un pulso o el resaltado; fuera de
 *     pantalla no corre nada. Densidad de píxeles limitada a 1.5 en móvil.
 *
 * Movimiento reducido: el globo queda quieto en su encuadre final, completo.
 * La lista de salas es el contenido real, legible e indexable; pasar el
 * cursor o el foco por una sala resalta su arco.
 */
import { salas, coordenadas, paisDe, type Ciudad, type Pais } from '../../i18n/contenido';

interface Props {
  titulo: string;
  alt: string;
  origen: string;
  ciudades: Record<Ciudad, string>;
  paises: Record<Pais, string>;
}
const { titulo, alt, origen, ciudades, paises } = Astro.props;

const lugar = (c: Ciudad) => `${ciudades[c]}, ${paises[paisDe[c]]}`;
const datos = {
  origen: coordenadas.bogota,
  ciudades: Object.fromEntries(
    [...new Set(salas.map((s) => s.ciudad))].map((c) => [c, coordenadas[c]]).filter(([, v]) => v),
  ),
  etiquetaOrigen: origen,
  nombres: Object.fromEntries(salas.map((s) => [s.ciudad, ciudades[s.ciudad]])),
};
const ultima = salas.at(-1)!;
---

<div class="escenarios" data-escenarios>
  <div class="escenarios__pista">
    <div class="escenarios__escena">
      <h3 class="antetitulo escenarios__titulo">{titulo}</h3>
      <p class="mapa__lectura" aria-hidden="true" data-lectura>
        <span class="mapa__sala" data-lectura-sala>{ultima.sala}</span>
        <span class="mapa__ciudad" data-lectura-ciudad>{lugar(ultima.ciudad)}</span>
      </p>
      <div class="globo" role="img" aria-label={alt} data-globo={JSON.stringify(datos)}>
        <canvas class="globo__lienzo" aria-hidden="true"></canvas>
      </div>
    </div>
  </div>

  <ul class="salas" data-salas>
    {
      salas.map((s) => (
        <li class="sala" data-ciudad={s.ciudad} data-lugar={lugar(s.ciudad)} tabindex="0">
          <span class="sala__nombre">{s.sala}</span>
          <span class="sala__ciudad">{ciudades[s.ciudad]}</span>
        </li>
      ))
    }
  </ul>
</div>

<script>
  type Datos = {
    origen: [number, number];
    ciudades: Record<string, [number, number]>;
    etiquetaOrigen: string;
    nombres: Record<string, string>;
  };
  type V3 = [number, number, number];

  const raiz = document.querySelector<HTMLElement>('[data-escenarios]');
  const caja = raiz?.querySelector<HTMLElement>('[data-globo]');
  const lienzo = caja?.querySelector<HTMLCanvasElement>('canvas');

  if (raiz && caja && lienzo) {
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const angosto = window.matchMedia('(max-width: 860px)');
    const datos = JSON.parse(caja.dataset.globo!) as Datos;
    const ctx = lienzo.getContext('2d')!;
    const estilo = getComputedStyle(raiz);
    const ORO = estilo.getPropertyValue('--sc-accent').trim() || '#f5c77e';
    const TINTA = estilo.getPropertyValue('--sc-ink').trim() || '#f2ede6';
    const RAD = Math.PI / 180;

    const vec = (lon: number, lat: number): V3 => {
      const l = lon * RAD;
      const f = lat * RAD;
      return [Math.cos(f) * Math.cos(l), Math.cos(f) * Math.sin(l), Math.sin(f)];
    };
    const dot = (a: V3, b: V3) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];

    // ---- datos fijos -------------------------------------------------------
    const items = Array.from(raiz.querySelectorAll<HTMLElement>('.sala'));
    const N = items.length;
    const O = vec(...datos.origen);
    const ciudades = new Map(Object.entries(datos.ciudades).map(([c, ll]) => [c, vec(...ll)]));

    // Cada arco: 48 muestras del gran círculo, elevadas en proporción a la distancia.
    const MUESTRAS = 48;
    const arcos = new Map<string, Float32Array>();
    for (const [c, P] of ciudades) {
      if (c === 'bogota') continue;
      const ang = Math.acos(Math.min(1, Math.max(-1, dot(O, P))));
      const s = Math.sin(ang) || 1;
      const alto = Math.min(0.32, 0.06 + ang * 0.22);
      const pts = new Float32Array((MUESTRAS + 1) * 3);
      for (let i = 0; i <= MUESTRAS; i++) {
        const t = i / MUESTRAS;
        const a = Math.sin((1 - t) * ang) / s;
        const b = Math.sin(t * ang) / s;
        const h = 1 + Math.sin(Math.PI * t) * alto;
        pts[i * 3] = (a * O[0] + b * P[0]) * h;
        pts[i * 3 + 1] = (a * O[1] + b * P[1]) * h;
        pts[i * 3 + 2] = (a * O[2] + b * P[2]) * h;
      }
      arcos.set(c, pts);
    }

    // La malla general del mundo y, para Europa de cerca, una más fina que se
    // funde encima mientras la general se retira de esa región.
    let tierra: Float32Array | null = null;
    let tierraEnEuropa: Uint8Array | null = null;
    let tierraFueraDeEuropa: Uint8Array | null = null;
    let europa: Float32Array | null = null;

    // ---- cámara ------------------------------------------------------------
    // Encuadres: sobre Bogotá, las Américas, el cruce del Atlántico, Europa de
    // cerca (sus once salas están a pocos grados unas de otras y de lejos se
    // amontonan) y el plano completo al final.
    const EUROPA = angosto.matches ? 5.2 : 4.2;
    const planos: { p: number; lon: number; lat: number; zoom: number }[] = [
      { p: 0, lon: -74, lat: 4, zoom: 1.1 },
      { p: 0.24, lon: -80, lat: 14, zoom: 1.02 },
      { p: 0.36, lon: -38, lat: 32, zoom: 1.0 },
      { p: 0.47, lon: 8.2, lat: 50, zoom: EUROPA },
      { p: 0.86, lon: 9.2, lat: 50.2, zoom: EUROPA * 1.06 },
      { p: 1, lon: -42, lat: 24, zoom: 0.96 },
    ];
    // Lado de cada etiqueta en Europa, para que las vecinas no se pisen.
    const aLaIzquierda = new Set(['paris', 'amsterdam', 'colonia', 'friburgo', 'berna']);
    const suave = (x: number) => x * x * (3 - 2 * x);
    const camara = (p: number) => {
      let i = 0;
      while (i < planos.length - 2 && p > planos[i + 1]!.p) i++;
      const a = planos[i]!;
      const b = planos[i + 1]!;
      const t = suave(Math.min(1, Math.max(0, (p - a.p) / (b.p - a.p))));
      return { lon: a.lon + (b.lon - a.lon) * t, lat: a.lat + (b.lat - a.lat) * t, zoom: a.zoom + (b.zoom - a.zoom) * t };
    };

    // ---- estado ------------------------------------------------------------
    let W = 0, H = 0, dpr = 1;
    let p = reducido ? 1 : 0;
    let sucio = true;
    let pulsos = false;
    let foco: string | null = null;
    const llegada = new Map<string, number>(); // ciudad → instante en que se encendió
    const trazo = new Map<string, number>();
    const T0 = 0.06, T1 = 0.9;
    const compas = (T1 - T0) / N;

    const ajustar = () => {
      dpr = Math.min(window.devicePixelRatio || 1, angosto.matches ? 1.5 : 2);
      W = Math.round(caja.clientWidth * dpr);
      H = Math.round(caja.clientHeight * dpr);
      lienzo.width = W;
      lienzo.height = H;
      sucio = true;
    };

    const lectura = raiz.querySelector<HTMLElement>('[data-lectura]')!;
    const lSala = raiz.querySelector<HTMLElement>('[data-lectura-sala]')!;
    const lCiudad = raiz.querySelector<HTMLElement>('[data-lectura-ciudad]')!;
    let leida = -2;
    const leer = (i: number) => {
      if (i === leida) return;
      leida = i;
      if (i < 0) {
        lectura.classList.remove('mapa__lectura--vista');
        return;
      }
      lSala.textContent = items[i]!.querySelector('.sala__nombre')!.textContent;
      lCiudad.textContent = items[i]!.dataset.lugar ?? '';
      lectura.classList.remove('mapa__lectura--cambio');
      void lectura.offsetWidth;
      lectura.classList.add('mapa__lectura--vista', 'mapa__lectura--cambio');
    };

    const avanzar = (ahora: number) => {
      let ultimaSala = -1;
      trazo.clear();
      for (let i = 0; i < N; i++) {
        const c = items[i]!.dataset.ciudad!;
        const k = Math.min(1, Math.max(0, (p - (T0 + i * compas)) / (compas * 0.8)));
        trazo.set(c, Math.max(trazo.get(c) ?? 0, k));
        items[i]!.classList.toggle('sala--encendida', k >= 1);
        if (k >= 1) ultimaSala = i;
      }
      for (const c of ciudades.keys()) {
        const k = c === 'bogota' ? 1 : (trazo.get(c) ?? 0);
        if (k >= 1 && !llegada.has(c)) {
          llegada.set(c, reducido ? -1e9 : ahora);
          pulsos = true;
        }
        if (k < 1) llegada.delete(c);
      }
      if (!foco) leer(ultimaSala);
    };

    // ---- dibujo ------------------------------------------------------------
    /** Pinta un cuadro. Devuelve true si queda algún pulso animándose. */
    const pintar = (ahora: number) => {
      const cam = camara(p);
      const f = vec(cam.lon, cam.lat);
      const l0 = cam.lon * RAD, f0 = cam.lat * RAD;
      const e: V3 = [-Math.sin(l0), Math.cos(l0), 0];
      const n: V3 = [-Math.sin(f0) * Math.cos(l0), -Math.sin(f0) * Math.sin(l0), Math.cos(f0)];
      const R = Math.min(W, H) * 0.45 * cam.zoom;
      const cx = W / 2;
      const cy = H / 2;

      ctx.clearRect(0, 0, W, H);

      // La esfera: un volumen apenas iluminado desde arriba a la izquierda.
      const g = ctx.createRadialGradient(cx - R * 0.35, cy - R * 0.4, R * 0.1, cx, cy, R);
      g.addColorStop(0, 'rgba(245, 199, 126, 0.07)');
      g.addColorStop(0.7, 'rgba(36, 28, 22, 0.35)');
      g.addColorStop(1, 'rgba(20, 16, 13, 0.55)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.fill();
      ctx.lineWidth = dpr;
      ctx.strokeStyle = 'rgba(242, 237, 230, 0.10)';
      ctx.stroke();

      // Tierra: puntos más grandes y claros hacia el frente, más tenues en el borde.
      const cerca = Math.min(1, Math.max(0, (cam.zoom - 1.8) / 1.4));
      const puntos = (t: Float32Array, tam: number, mult: number, omitir: Uint8Array | null) => {
        const capas = [0.16, 0.3, 0.48, 0.7];
        ctx.fillStyle = TINTA;
        for (let c = 0; c < 4; c++) {
          ctx.globalAlpha = capas[c]! * mult;
          ctx.beginPath();
          for (let i = 0; i < t.length; i += 3) {
            if (omitir && omitir[i / 3]) continue;
            const x = t[i]!, y = t[i + 1]!, z = t[i + 2]!;
            const Z = x * f[0] + y * f[1] + z * f[2];
            if (Z <= 0.02) continue;
            const capa = Z < 0.3 ? 0 : Z < 0.55 ? 1 : Z < 0.8 ? 2 : 3;
            if (capa !== c) continue;
            const X = x * e[0] + y * e[1] + z * e[2];
            const Y = x * n[0] + y * n[1] + z * n[2];
            const sx = cx + X * R, sy = cy - Y * R;
            if (sx < -6 || sy < -6 || sx > W + 6 || sy > H + 6) continue;
            const s = tam * (0.55 + 0.45 * Z);
            ctx.rect(sx - s / 2, sy - s / 2, s, s);
          }
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      };
      if (tierra) {
        const tam = Math.min(3.2 * dpr, Math.max(1.3 * dpr, (R / 230) * dpr));
        if (cerca > 0 && europa && tierraEnEuropa) {
          // De cerca: la malla general fuera de Europa, y dentro, la fina.
          puntos(tierra, tam, 1, tierraEnEuropa);
          puntos(europa, Math.min(2.6 * dpr, tam * 0.8), cerca, null);
          if (cerca < 1 && tierraFueraDeEuropa) puntos(tierra, tam, 1 - cerca, tierraFueraDeEuropa);
        } else {
          puntos(tierra, tam, 1, null);
        }
      }

      const proyectar = (x: number, y: number, z: number) => {
        const Z = x * f[0] + y * f[1] + z * f[2];
        const X = x * e[0] + y * e[1] + z * e[2];
        const Y = x * n[0] + y * n[1] + z * n[2];
        // Visible si está de frente o sobresale del disco (arcos elevados).
        const ve = Z > 0 || X * X + Y * Y > 1;
        return { sx: cx + X * R, sy: cy - Y * R, ve, Z };
      };

      // Arcos.
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.strokeStyle = ORO;
      ctx.fillStyle = ORO;
      for (const [c, pts] of arcos) {
        const k = foco === c ? 1 : (trazo.get(c) ?? 0);
        if (k <= 0) continue;
        const hasta = k * MUESTRAS;
        const tenue = foco !== null && c !== foco;
        ctx.globalAlpha = tenue ? 0.18 : 0.9;
        ctx.lineWidth = (foco === c ? 2.6 : 1.5) * dpr;
        ctx.beginPath();
        let abierto = false;
        let cabeza: { sx: number; sy: number } | null = null;
        for (let i = 0; i <= Math.ceil(hasta); i++) {
          const j = Math.min(i, hasta);
          const i0 = Math.min(Math.floor(j), MUESTRAS - 1), fr = j - i0;
          const a = i0 * 3, b = (i0 + 1) * 3;
          const q = proyectar(
            pts[a]! + (pts[b]! - pts[a]!) * fr,
            pts[a + 1]! + (pts[b + 1]! - pts[a + 1]!) * fr,
            pts[a + 2]! + (pts[b + 2]! - pts[a + 2]!) * fr,
          );
          if (!q.ve) {
            abierto = false;
            continue;
          }
          if (abierto) ctx.lineTo(q.sx, q.sy);
          else ctx.moveTo(q.sx, q.sy);
          abierto = true;
          cabeza = q;
        }
        ctx.stroke();
        // La punta del arco mientras viaja.
        if (cabeza && k < 1 && !tenue) {
          ctx.globalAlpha = 1;
          ctx.beginPath();
          ctx.arc(cabeza.sx, cabeza.sy, 2.6 * dpr, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;

      // Ciudades: apagadas hasta que llega su arco; al llegar, un anillo que se abre.
      let animando = false;
      for (const [c, P] of ciudades) {
        const q = proyectar(P[0], P[1], P[2]);
        if (q.Z <= 0) continue;
        const t0 = llegada.get(c);
        const encendida = t0 !== undefined;
        const r = (c === 'bogota' ? 4.2 : 3) * dpr * (foco === c ? 1.6 : 1);
        ctx.fillStyle = encendida ? ORO : 'rgba(242, 237, 230, 0.35)';
        ctx.beginPath();
        ctx.arc(q.sx, q.sy, encendida ? r : r * 0.7, 0, Math.PI * 2);
        ctx.fill();
        // De cerca, cada ciudad encendida lleva su nombre al lado.
        if (encendida && cerca > 0 && c !== 'bogota') {
          const izq = aLaIzquierda.has(c);
          ctx.globalAlpha = cerca * (foco && foco !== c ? 0.35 : 0.9);
          ctx.font = `italic ${Math.round((angosto.matches ? 11 : 13) * dpr)}px Newsreader, Georgia, serif`;
          ctx.fillStyle = TINTA;
          ctx.textAlign = izq ? 'right' : 'left';
          ctx.textBaseline = 'middle';
          ctx.fillText(datos.nombres[c] ?? '', q.sx + (izq ? -8 : 8) * dpr, q.sy);
          ctx.textAlign = 'left';
          ctx.textBaseline = 'alphabetic';
          ctx.globalAlpha = 1;
        }
        if (encendida && !reducido) {
          const fase = c === 'bogota' ? (ahora % 2600) / 2600 : (ahora - t0!) / 1100;
          if (fase >= 0 && fase < 1) {
            animando = true;
            ctx.strokeStyle = ORO;
            ctx.globalAlpha = 0.85 * (1 - fase);
            ctx.lineWidth = dpr;
            ctx.beginPath();
            ctx.arc(q.sx, q.sy, r + fase * 16 * dpr, 0, Math.PI * 2);
            ctx.stroke();
            ctx.globalAlpha = 1;
          }
        }
      }

      // Etiqueta de la casa.
      const b = proyectar(O[0], O[1], O[2]);
      if (b.Z > 0.15) {
        ctx.font = `italic ${Math.round((angosto.matches ? 12 : 14) * dpr)}px Newsreader, Georgia, serif`;
        ctx.fillStyle = 'rgba(242, 237, 230, 0.7)';
        ctx.fillText(datos.etiquetaOrigen, b.sx + 9 * dpr, b.sy + 18 * dpr);
      }
      return animando;
    };

    // ---- scroll y bucle ----------------------------------------------------
    const pista = raiz.querySelector<HTMLElement>('.escenarios__pista')!;
    const progreso = () => {
      const r = pista.getBoundingClientRect();
      return Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - window.innerHeight)));
    };

    let visible = false;
    let corriendo = false;
    const cuadro = (ahora: number) => {
      if (!visible) {
        corriendo = false;
        return;
      }
      if (!reducido) {
        const q = Math.round(progreso() * 2000) / 2000;
        if (q !== p) {
          p = q;
          sucio = true;
        }
      }
      if (sucio) avanzar(ahora);
      if (sucio || pulsos) pulsos = pintar(ahora);
      sucio = false;
      requestAnimationFrame(cuadro);
    };
    const arrancar = () => {
      if (corriendo) return;
      corriendo = true;
      requestAnimationFrame(cuadro);
    };

    if (!reducido) raiz.classList.add('escenarios--vivo');

    new IntersectionObserver((en) => {
      visible = en[0]!.isIntersecting;
      if (visible) arrancar();
    }).observe(caja);

    // Los puntos de tierra, solo cuando el globo se acerca.
    const cargar = new IntersectionObserver(
      (en) => {
        if (!en[0]!.isIntersecting) return;
        cargar.disconnect();
        const leerMalla = (url: string, marcar: boolean) =>
          fetch(url)
            .then((r) => r.arrayBuffer())
            .then((buf) => {
              const ll = new Int16Array(buf);
              const t = new Float32Array((ll.length / 2) * 3);
              const dentro = new Uint8Array(ll.length / 2);
              for (let i = 0, j = 0; i < ll.length; i += 2, j += 3) {
                const lon = ll[i]! / 100, lat = ll[i + 1]! / 100;
                const v = vec(lon, lat);
                t[j] = v[0];
                t[j + 1] = v[1];
                t[j + 2] = v[2];
                if (marcar) dentro[i / 2] = lon >= -12 && lon <= 27 && lat >= 35 && lat <= 61 ? 1 : 0;
              }
              return { t, dentro };
            });
        Promise.all([leerMalla('/media/globo.bin', true), leerMalla('/media/globo-europa.bin', false)])
          .then(([general, fina]) => {
            tierra = general.t;
            tierraEnEuropa = general.dentro;
            tierraFueraDeEuropa = general.dentro.map((v) => (v ? 0 : 1));
            europa = fina.t;
            sucio = true;
            arrancar();
          })
          .catch(() => {});
      },
      { rootMargin: '1200px 0px' },
    );
    cargar.observe(caja);

    new ResizeObserver(() => {
      ajustar();
      arrancar();
    }).observe(caja);
    ajustar();

    // Resaltar una sala desde la lista (cursor o foco).
    items.forEach((it, i) => {
      const entrar = () => {
        foco = it.dataset.ciudad!;
        leer(i);
        sucio = true;
        arrancar();
      };
      const salir = () => {
        foco = null;
        leida = -2;
        sucio = true;
        arrancar();
      };
      it.addEventListener('pointerenter', entrar);
      it.addEventListener('focus', entrar);
      it.addEventListener('pointerleave', salir);
      it.addEventListener('blur', salir);
    });
  }
</script>
