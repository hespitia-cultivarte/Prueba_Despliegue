---
/**
 * X · La Fundación (Tranquillo). El único lugar, además del pie, donde manda la
 * marca madre: fondo blanco y el naranja #FF671B (DESIGN.md §1). El naranja no
 * alcanza contraste de texto sobre blanco, así que va como regla y como fondo
 * del botón, con tinta oscura encima.
 */
import lockup from '../../assets/marca/lajoven-bd.svg?raw';
import { getContenido, urlFundacion } from '../../i18n/contenido';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const C = getContenido(locale);
const f = C.fundacion;
const m = C.movimientos[9]!;
---

<section
  id={m.id}
  class="fundacion sc-section suelo-blanco"
  data-suelo="claro"
  data-movimiento={m.id}
  data-mov-numero={m.numero}
  data-mov-nombre={m.nombre}
>
  <div class="sc-wrap fundacion__rejilla">
    <div data-sc-in>
      <div class="fundacion__lockup" set:html={lockup} />
      <span class="fundacion__regla" aria-hidden="true"></span>
      <h2 class="titular titular--lg">{f.titulo}</h2>
    </div>
    <div class="fundacion__texto" data-sc-stagger="90" data-sc-in>
      {f.parrafos.map((p) => <p class="voz">{p}</p>)}
      <a class="boton-fbd" href={urlFundacion} target="_blank" rel="noopener">
        {f.boton}
        <span class="visualmente-oculto">{` ${f.nuevaPestana}`}</span>
      </a>
    </div>
  </div>
</section>
