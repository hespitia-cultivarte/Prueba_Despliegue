---
/**
 * IV · Intermezzo (Adagio). El pico de la página y la firma del sitio.
 *
 * Silencio de autor: el acto abre en negro con una sola línea (BRIEF.md). Luego
 * la sala del Teatro Metropolitano (© Marcela Gómez) se enciende vela por vela
 * desde el escenario hacia afuera. Las 60 velas son las de la foto, detectadas
 * por scripts/candles.py: la luz no se inventa, se destapa donde ya estaba.
 *
 * Canvas propio de la página, leyendo el progreso del acto. El motor de
 * scroll-craft no se toca. Sin JS o con movimiento reducido: la foto quieta,
 * las dos frases visibles.
 */
import { Picture, getImage } from 'astro:assets';
import { foto } from '../../lib/foto';
import velas from '../../lib/velas.json';
import { getContenido } from '../../i18n/contenido';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const C = getContenido(locale);
const frase = C.frase;
const m = C.movimientos[3]!;
const clave = 'peak/sala-velas';
const img = foto(clave);
const grande = await getImage({ src: img, width: 2400, format: 'webp', quality: 82 });
const chica = await getImage({ src: img, width: 1280, format: 'webp', quality: 80 });
---

<section
  id={m.id}
  class="intermezzo"
  data-sc-act="pin"
  data-sc-span="3.6"
  data-sc-drift="#0D0A08"
  data-movimiento={m.id}
  data-mov-numero={m.numero}
  data-mov-nombre={m.nombre}
>
  <div class="intermezzo__stage" data-sc-stage data-velas data-sc-verify-state="0">
    <Picture
      src={img}
      formats={['avif', 'webp']}
      widths={[1280, 2400]}
      sizes="100vw"
      alt={frase.alt}
      class="intermezzo__foto"
    />
    <canvas
      class="intermezzo__lienzo"
      aria-hidden="true"
      data-src-grande={grande.src}
      data-src-chica={chica.src}
      data-velas-json={JSON.stringify(velas)}
    ></canvas>
    <div class="intermezzo__scrim" aria-hidden="true"></div>

    <div class="intermezzo__copia">
      <p class="intermezzo__uno" data-sc-cue="0 0.96 0 0.1">{frase.primera}</p>
      <p class="intermezzo__dos" data-sc-cue="0.3 0.97 0.12 0.08" data-sc-kinetic="lines">{frase.segunda}</p>
      <span class="regla regla--larga" data-sc-cue="0.42 0.97 0.1 0.08" aria-hidden="true"></span>
    </div>
  </div>
</section>

<script>
  type Vela = { x: number; y: number; s: number };
  type Datos = { aspect: number; candles: Vela[]; stage: Vela };

  const stage = document.querySelector<HTMLElement>('[data-velas]');
  const lienzo = stage?.querySelector<HTMLCanvasElement>('canvas');
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stage && lienzo && !reducido) {
    const act = stage.closest<HTMLElement>('[data-sc-act]')!;
    const datos = JSON.parse(lienzo.dataset.velasJson!) as Datos;
    const N = datos.candles.length;
    const ctx = lienzo.getContext('2d')!;
    const mascara = document.createElement('canvas');
    const mctx = mascara.getContext('2d')!;

    // Un solo sprite de brillo, reutilizado: más barato que un gradiente por vela.
    const sprite = document.createElement('canvas');
    sprite.width = sprite.height = 128;
    const sctx = sprite.getContext('2d')!;
    const g = sctx.createRadialGradient(64, 64, 0, 64, 64, 64);
    g.addColorStop(0, 'rgba(255,255,255,1)');
    g.addColorStop(0.35, 'rgba(255,255,255,0.55)');
    g.addColorStop(1, 'rgba(255,255,255,0)');
    sctx.fillStyle = g;
    sctx.fillRect(0, 0, 128, 128);

    const foto = new Image();
    foto.decoding = 'async';
    foto.src = window.innerWidth > 1100 ? lienzo.dataset.srcGrande! : lienzo.dataset.srcChica!;

    let W = 0, H = 0, dpr = 1, listo = false, visible = false, ultimo = -1;

    const ajustar = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      W = Math.round(stage.clientWidth * dpr);
      H = Math.round(stage.clientHeight * dpr);
      lienzo.width = mascara.width = W;
      lienzo.height = mascara.height = H;
      ultimo = -1;
    };

    // object-fit: cover con object-position = (stage.x, 50%), igual que la foto
    // estática de debajo (.intermezzo__foto), para que el relevo no salte.
    const cubrir = () => {
      const ar = datos.aspect;
      let dw = W, dh = W / ar;
      if (dh < H) { dh = H; dw = H * ar; }
      const dx = (W - dw) * datos.stage.x;
      const dy = (H - dh) / 2;
      return { dx, dy, dw, dh };
    };

    const suave = (a: number, b: number, v: number) => {
      const t = Math.min(1, Math.max(0, (v - a) / (b - a)));
      return t * t * (3 - 2 * t);
    };

    const pintar = (p: number) => {
      const { dx, dy, dw, dh } = cubrir();
      mctx.globalCompositeOperation = 'source-over';
      mctx.clearRect(0, 0, W, H);
      mctx.globalCompositeOperation = 'lighter';

      // Las velas se encienden entre p 0.22 y 0.72, del escenario hacia afuera.
      let encendidas = 0;
      for (let i = 0; i < N; i++) {
        const v = datos.candles[i]!;
        const t0 = 0.22 + (0.5 * i) / N;
        const k = suave(t0, t0 + 0.07, p);
        if (k <= 0) continue;
        encendidas++;
        const r = (0.05 + 0.07 * v.s) * dw * (0.5 + 0.5 * k);
        mctx.globalAlpha = k;
        mctx.drawImage(sprite, dx + v.x * dw - r, dy + v.y * dh - r, r * 2, r * 2);
      }
      // La luz cenital del atril, al final.
      const kE = suave(0.66, 0.8, p);
      if (kE > 0) {
        const s = datos.stage;
        const rw = 0.26 * dw, rh = 0.34 * dh;
        mctx.globalAlpha = kE;
        mctx.drawImage(sprite, dx + s.x * dw - rw, dy + s.y * dh - rh * 1.1, rw * 2, rh * 2);
      }
      // Luz ambiente: la sala entera asoma, sin llegar nunca a "luces de sala".
      const kA = suave(0.7, 0.94, p) * 0.6;
      if (kA > 0) {
        mctx.globalAlpha = kA;
        mctx.fillStyle = '#fff';
        mctx.fillRect(0, 0, W, H);
      }
      mctx.globalAlpha = 1;

      ctx.globalCompositeOperation = 'source-over';
      ctx.clearRect(0, 0, W, H);
      ctx.drawImage(foto, dx, dy, dw, dh);
      ctx.globalCompositeOperation = 'destination-in';
      ctx.drawImage(mascara, 0, 0);
      ctx.globalCompositeOperation = 'source-over';

      // Para el arnés de verificación: lo que realmente se pinta, redondeado.
      stage.dataset.scVerifyState = `${encendidas}/${Math.round(kE * 10)}/${Math.round(kA * 20)}`;
    };

    const progreso = () => {
      const r = act.getBoundingClientRect();
      const recorrido = Math.max(1, r.height - window.innerHeight);
      return Math.min(1, Math.max(0, -r.top / recorrido));
    };

    const bucle = () => {
      if (!visible) return;
      const p = progreso();
      const q = Math.round(p * 600);
      if (listo && q !== ultimo) {
        ultimo = q;
        pintar(p);
      }
      requestAnimationFrame(bucle);
    };

    new IntersectionObserver((e) => {
      visible = e[0]!.isIntersecting;
      if (visible) requestAnimationFrame(bucle);
    }).observe(stage);

    foto.decode().then(() => {
      listo = true;
      ajustar();
      stage.classList.add('intermezzo--vivo');
      if (visible) requestAnimationFrame(bucle);
    }).catch(() => {});

    window.addEventListener('resize', ajustar, { passive: true });
  }
</script>
